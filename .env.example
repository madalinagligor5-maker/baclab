# URL public al site-ului (pentru metadate / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accesul gratuit/premium. "off" = tot conținutul e deschis (beta). "on" = se aplică limitele din src/config/product.ts
# Atenție: "on" are sens doar după ce există conturi + plăți (Faza 2), altfel nu se poate verifica cine a plătit.
NEXT_PUBLIC_PAYWALL=off

# Faza 2 – conturi și sincronizare (Supabase). Lasă goale până le configurezi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Faza 2 – plăți (Stripe). Doar pe server, niciodată NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
